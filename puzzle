<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>숫자 퍼즐 게임</title>
<style>
  body{
    font-family: Arial, sans-serif;
    background:#222;
    color:white;
    text-align:center;
    margin:0;
    padding:20px;
  }

  h1{
    margin-bottom:10px;
  }

  #board{
    width:320px;
    margin:20px auto;
    display:grid;
    grid-template-columns: repeat(4, 1fr);
    gap:5px;
  }

  .tile{
    width:75px;
    height:75px;
    background:#4caf50;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:28px;
    font-weight:bold;
    border-radius:10px;
    cursor:pointer;
    transition:0.2s;
  }

  .tile:hover{
    background:#66bb6a;
  }

  .empty{
    background:#111;
    cursor:default;
  }

  button{
    padding:10px 20px;
    font-size:16px;
    border:none;
    border-radius:8px;
    background:#2196f3;
    color:white;
    cursor:pointer;
  }

  button:hover{
    background:#42a5f5;
  }

  #message{
    margin-top:15px;
    font-size:20px;
    color:#ffd54f;
  }
</style>
</head>
<body>

<h1>🔢 숫자 퍼즐 게임</h1>
<p>숫자를 순서대로 맞춰보세요!</p>

<button onclick="shuffle()">섞기</button>

<div id="board"></div>

<div id="message"></div>

<script>
  const board = document.getElementById("board");
  const message = document.getElementById("message");

  let tiles = [];

  function init(){
    tiles = [...Array(15).keys()].map(n => n + 1);
    tiles.push(0);
    render();
  }

  function render(){
    board.innerHTML = "";

    tiles.forEach((num, index) => {
      const tile = document.createElement("div");

      if(num === 0){
        tile.className = "tile empty";
      } else {
        tile.className = "tile";
        tile.textContent = num;
        tile.onclick = () => move(index);
      }

      board.appendChild(tile);
    });

    checkWin();
  }

  function move(index){
    const emptyIndex = tiles.indexOf(0);

    const validMoves = [
      emptyIndex - 1,
      emptyIndex + 1,
      emptyIndex - 4,
      emptyIndex + 4
    ];

    // 좌우 줄바꿈 방지
    if(
      (index === emptyIndex -1 && emptyIndex %4 !==0) ||
      (index === emptyIndex +1 && index %4 !==0) ||
      index === emptyIndex -4 ||
      index === emptyIndex +4
    ){
      [tiles[index], tiles[emptyIndex]] =
      [tiles[emptyIndex], tiles[index]];

      render();
    }
  }

  function shuffle(){
    for(let i=0; i<1000; i++){
      const emptyIndex = tiles.indexOf(0);

      const possible = [];

      if(emptyIndex %4 !==0) possible.push(emptyIndex -1);
      if(emptyIndex %4 !==3) possible.push(emptyIndex +1);
      if(emptyIndex >3) possible.push(emptyIndex -4);
      if(emptyIndex <12) possible.push(emptyIndex +4);

      const moveIndex =
        possible[Math.floor(Math.random()*possible.length)];

      [tiles[moveIndex], tiles[emptyIndex]] =
      [tiles[emptyIndex], tiles[moveIndex]];
    }

    message.textContent = "";
    render();
  }

  function checkWin(){
    for(let i=0; i<15; i++){
      if(tiles[i] !== i+1){
        return;
      }
    }

    if(tiles[15] === 0){
      message.textContent = "🎉 퍼즐 완성!";
    }
  }

  init();
</script>

</body>
</html>
